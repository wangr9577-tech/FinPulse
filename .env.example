# =================================================================
# 后端服务 API 密钥配置文件模板 (backend/.env.example)
# =================================================================

# LLM API 密钥
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# 双阶 Agent 模型选型
FLASH_MODEL_NAME=gpt-4o-mini
PRO_MODEL_NAME=gpt-4o

# MongoDB 数据库
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intelligent_research_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# 后端与抓取配置
FASTAPI_PORT=8000

# 研报与爬虫数据时间窗口配置 (单位：小时，控制数据抓取与研报推演的时间窗口)
REPORT_HOURS_BACK=24.0
CRAWL_REQUEST_TIMEOUT=12.0

# 3. SMTP 邮件发送配置
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your_email@qq.com
SMTP_AUTH_CODE=your_smtp_auth_code_here
DEFAULT_RECEIVERS=receiver1@qq.com,receiver2@sina.com


