# =================================================================
# DeepSeek LLM 后端环境配置文件模板 (backend/.env.example)
# =================================================================

# 1. DeepSeek 大模型配置
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1

# 统一 Agent 大模型选型与超时重试配置
LLM_MODEL_NAME=deepseek-v4-flash
LLM_REQUEST_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# 2. MongoDB 数据库配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intelligent_research_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

FASTAPI_PORT=8000

# 3. 研报与爬虫数据时间窗口配置 (单位：小时，控制数据抓取与研报推演的时间窗口)
REPORT_HOURS_BACK=24.0
CRAWL_REQUEST_TIMEOUT=12.0

# 4. SMTP 邮件发送配置
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your_email@domain.com
SMTP_AUTH_CODE=your_smtp_auth_code
DEFAULT_RECEIVERS=receiver1@domain.com,receiver2@domain.com

# 5. RSSHub 镜像节点配置
RSSHUB_INSTANCES=https://rsshub.rssforever.com,https://rsshub.app,https://rss.hub.maipdf.com

# 6. 高频新闻抓取 URL 阵列配置
SINA_7X24_URL=https://zhibo.sina.com.cn/api/zhibo/feed?page=1&page_size=50&zhibo_id=152
EASTMONEY_URL=https://newsapi.eastmoney.com/kuaixun/v2/api/list?pageSize=50&pageIndex=1
KR36_RSS_URL=https://36kr.com/feed
CAILIANPRESS_ROUTE=/cls/telegraph
WALLSTREETCN_ROUTE=/wallstreetcn/live/global
ITHOME_RSS_URL=https://www.ithome.com/rss/
TMTPOST_RSS_URL=https://www.tmtpost.com/rss
EETCHINA_GNEWS_URL=https://news.google.com/rss/search?q=%E7%94%B5%E5%AD%90%E5%B7%A5%E7%A8%8B%E4%B8%93%E8%BE%91+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
EETCHINA_ROUTE=/eetchina/news
JIQIZHIXIN_GNEWS_URL=https://news.google.com/rss/search?q=%E6%9C%BA%E5%99%A8%E4%B9%8B%E5%BF%83+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
JIQIZHIXIN_ROUTE=/jiqizhixin
QBITAI_GNEWS_URL=https://news.google.com/rss/search?q=%E9%87%8F%E5%AD%90%E4%BD%8D+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
QBITAI_ROUTE=/qbitai
REUTERS_GNEWS_URL=https://news.google.com/rss/search?q=site:reuters.com+when:24h&hl=en-US&gl=US&ceid=US:en
REUTERS_ROUTE=/reuters/world
BLOOMBERG_RSS_URL=https://feeds.bloomberg.com/markets/news.rss
BLOOMBERG_GNEWS_URL=https://news.google.com/rss/search?q=site:bloomberg.com+when:24h&hl=en-US&gl=US&ceid=US:en
YAHOOFINANCE_RSS_URL=https://finance.yahoo.com/news/rssindex
YAHOOFINANCE_INDEX_RSS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline?s=^GSPC&region=US&lang=en-US
JIEMIAN_RSS_URL=https://www.jiemian.com/rss
JIEMIAN_CONSUMER_ROUTE=/jiemian/list/32
JIEMIAN_INVEST_ROUTE=/jiemian/list/114
DIVIDEND_GNEWS_URL=https://news.google.com/rss/search?q=%E9%AB%98%E8%82%A1%E6%81%AF+OR+%E7%BA%A2%E5%88%A9+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
LOWVAL_GNEWS_URL=https://news.google.com/rss/search?q=%E7%A0%B4%E5%87%80+OR+%E4%BD%8E%E4%BC%B0%E5%80%BC+OR+%E8%82%A1%E4%BB%BD%E5%9B%9E%E8%B4%AD+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
CONSUMER_GNEWS_URL=https://news.google.com/rss/search?q=%E5%A4%A7%E6%B6%88%E8%B4%B9+OR+%E7%99%BD%E9%85%92+OR+%E9%A3%9F%E5%93%81%E9%A5%AE%E6%96%99+OR+%E9%9B%B6%E5%94%AE%E6%B6%88%E8%B4%B9+when:24h&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
