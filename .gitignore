# =================================================================
# FinPulse Monorepo 根级 Git Ignore
# 说明：backend/.gitignore 与 frontend/.gitignore、bff/.gitignore 已各自
#      处理子目录内的忽略；本文件负责根级与公共目录的排除。
# =================================================================

# ---- 敏感配置（绝不提交） ----
.env
.env.*
!.env.example

# ---- Python ----
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.coverage

# ---- 前端 / Node ----
node_modules/
.npm-cache/
dist/
*.local

# ---- 日志与运行残留 ----
*.log
logs/

# ---- IDE / Claude / OS ----
.claude/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 测试与临时残留文件 ----
_bashtest.txt
result.txt
stdout_test.txt
_tag_result*.txt
*.db
*.sqlite
*.sqlite3

# ---- 项目无关 / 个人目录（不入库） ----
backend.zip
frontend.zip
日报/
入职材料/
语音文件/
*.pdf

# ---- 本地工具 / 生成产物（不入库） ----
.deck/
.mcp.json

# ---- 外部公告抓取源码（含真实密钥 / PII，绝不入库） ----
gonggao_code_*/
gonggao_code_*.zip

# ---- 市场与研报数据产物（可再生成，不入库） ----
backend/data/raw/
backend/data/processed/
backend/data/cleaned_data/
backend/data/results/
backend/data/source_data/
backend/data/logs/
backend/data/mongodb/
backend/data/**/*.csv

# ---- stock_daily 运行产物（缓存与分析结果，保留 bundled_trade_days.csv 依赖） ----
backend/app/stock_daily/data/analysis/
backend/app/stock_daily/data/trade_calendar_*.csv
